#!/usr/bin/env sh
# oxwm-update - perbarui komponen OXWM yang outdated (bangun ulang selektif).
# Selalu memakai installer terbaru dari GitHub agar versi komponen ikut terbaru.
# Alias pendek: oxu. Butuh sudo + koneksi internet (cek versi ke upstream).
# Pakai: oxu [--check] [--latest] [--yes]
set -eu
REPO_SLUG="${OXWM_REPO_SLUG:-itah-btw/oxi}"
REF="${OXWM_REF:-main}"
action=self-update
latest=0
yes=0
for arg in "$@"; do
    case "$arg" in
        --check) action=check ;;
        --latest) latest=1 ;;
        --yes) yes=1 ;;
        *) echo "opsi tidak dikenal: $arg (pakai: oxu [--check] [--latest] [--yes])" >&2; exit 2 ;;
    esac
done
# Installer tidak lagi memakai flag; mode dipilih lewat environment internal.
# shellcheck disable=SC2086
exec curl -fsSL --retry 3 --retry-delay 2 --proto '=https' --proto-redir '=https' \
    "https://raw.githubusercontent.com/${REPO_SLUG}/${REF}/oxi" \
    | sudo env OXWM_ACTION="$action" OXWM_LATEST="$latest" OXWM_YES="$yes" bash
