[global]
    monitor = 0
    follow = mouse
      width = 320
      height = (0, 120)
      origin = top-right
      offset = (12, 44)
    font = JetBrainsMono Nerd Font 10
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#83a598"
    frame_width = 2
      corner_radius = 0
    gap_size = 8
    padding = 12
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    stack_duplicates = true
    show_age_threshold = 60
    idle_threshold = 120
[urgency_low]
    background = "#282828"
    foreground = "#928374"
    timeout = 5
[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    timeout = 10
[urgency_critical]
    background = "#fb4934"
    foreground = "#282828"
    frame_color = "#fb4934"
    timeout = 0
